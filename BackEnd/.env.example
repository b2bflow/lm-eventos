# Copie para .env e preencha. Nunca versione valores reais.

# --- Django ---
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=
LOG_LEVEL=INFO
# Limite de requisições por usuário logado e por IP anônimo (formato DRF: N/second|minute|hour|day)
API_USER_THROTTLE=300/minute
API_ANON_THROTTLE=10/minute
# Admin do Django (/admin/): desligado por padrão (o login dele não tem limite de tentativas)
DJANGO_ADMIN_ENABLED=False

# --- HTTPS em produção ---
# Atrás de proxy com HTTPS: HTTP_X_FORWARDED_PROTO
SECURE_PROXY_SSL_HEADER=
SECURE_SSL_REDIRECT=False
# Depois de confirmar que tudo abre em HTTPS: 31536000
SECURE_HSTS_SECONDS=0

# --- MongoDB ---
MONGO_DB_NAME=lm_dev
MONGO_HOST=localhost
MONGO_PORT=27017
DB_USERNAME=
MONGO_USERNAME=
MONGO_PASSWORD=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- OpenAI (IA) ---
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_MAX_AUDIO_TRANSCRIBE_MB=
CONTEXT_SIZE=100
DEBOUNCE_SECONDS=5

# --- Z-API ---
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
# Token exigido no webhook (cabeçalho X-Webhook-Token ou ?token=). Configure a URL na Z-API com ?token=<valor>.
ZAPI_WEBHOOK_TOKEN=
# Janela (s) para ignorar mensagem com texto idêntico do mesmo número
WEBHOOK_DEDUP_SECONDS=120

# --- Telefones operacionais ---
# Só aceita mensagens destes números (vazio = todos). Útil em homologação.
PHONES_FOR_VALIDATION=
ERICA_PHONE=
REGISTER_PHONE=

# --- Plataforma ---
# URL do painel, usada nos links enviados por WhatsApp (ex.: link do card)
FRONTEND_URL=http://localhost:5173
# URL pública desta API, usada no link assinado do PDF da proposta (vazio = caminho relativo)
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Google Agenda (conta Contato LM) ---
# Caminho para o client secret OAuth (fora do repositório) OU o JSON inteiro em GOOGLE_OAUTH_CLIENT_JSON
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/agenda/google/callback/
GOOGLE_CALENDAR_ID=primary
# Alternativa ao fluxo OAuth da plataforma: refresh token obtido pelo serviço OAuth da b2bflow
GOOGLE_REFRESH_TOKEN=
